# Copy this file to .env and fill in your values. Never commit .env.

# ---- LLM: pick ONE option ----

# Option A: Groq (cloud, free tier). Get a key at https://console.groq.com
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_your_key_here
LLM_MODEL=openai/gpt-oss-20b

# Option B: Ollama (100% local). Install Ollama, then: ollama pull llama3.2
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.2

# ---- Retrieval settings (defaults are fine to start) ----

# Embedding model; changing it means you must re-run ingest
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Target characters per chunk
CHUNK_SIZE=800
# Characters shared between neighbouring chunks (must be < CHUNK_SIZE)
CHUNK_OVERLAP=150
# How many chunks to retrieve per question
TOP_K=4
# Minimum cosine similarity for a chunk to count as relevant
MIN_SCORE=0.25
# Where the index is saved
STORAGE_DIR=storage
